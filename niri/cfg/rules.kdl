window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
    draw-border-with-background false
}

// if you use steam you will probably like these
window-rule {
    match app-id="steam"
    exclude title=r#"^[Ss]team$"#
    open-floating true
}

window-rule {
    match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"
    open-focused false
}

layer-rule {
    match namespace="vicinae"

    opacity 0.8
    background-effect {
        blur true
    }
}

layer-rule {
    match namespace="^noctalia-wallpaper*"
    place-within-backdrop true
}

window-rule {
    match app-id="google-chrome"
    match app-id="zen"
    match app-id="helium"

    default-column-width { proportion 0.8; }
}

window-rule {
    match app-id="com.microsoft.VSCode"
    match app-id="windsurf"
    match app-id="app.liten.Gram"

    open-maximized-to-edges true
}

window-rule {
    match app-id="Spotify"

    default-column-width { proportion 0.6; }
}

window-rule {
    match app-id="vesktop"

    default-column-width { proportion 0.7; }
}

window-rule {
    match app-id="com.obsproject.Studio" title="^OBS "

    default-column-width { proportion 0.7; }
}

window-rule {
    match app-id="Godot" title="^Godot$"

    open-maximized-to-edges true
}

window-rule {
    match app-id="Godot" title=r#".*\(DEBUG\)$"#

    open-floating true
}

window-rule {
    match app-id="com.t3tools.T3Code"

    default-column-width { proportion 0.7; }
}

window-rule {
    match app-id="beekeeper-studio"

    default-column-width { proportion 0.7; }
}

window-rule {
    match app-id="^Minecraft*"

    open-fullscreen true
}

window-rule {
    match app-id="twintaillauncher"

    default-column-width { proportion 0.9; }
}
