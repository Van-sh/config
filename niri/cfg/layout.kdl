layout {
    gaps 12 // Gap between windows
    always-center-single-column
    center-focused-column "never" // Don’t auto-center focused column

    background-color "transparent" // <- needed for noctalia-shell to set wallpaper
    fullscreen-backdrop-color "transparent" // <- needed for transparent apps in fullscreen

    focus-ring {
        width 3
    }

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
}
