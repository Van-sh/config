# Font Configuration
font-family = JetBrainsMono NF
font-size = 12

# Window Configuration
window-padding-x = 8
window-padding-y = 8
background-opacity = 0.5
background-blur = true

# Cursor Configuration
cursor-style = block
cursor-style-blink = true

# Scrollback
scrollback-limit = 100000

# Terminal features
mouse-hide-while-typing = true
copy-on-select = false
confirm-close-surface = false

# Working Directory setup
working-directory = home
window-inherit-working-directory = false

# Disable annoying copied to clipboard
app-notifications = no-clipboard-copy,no-config-reload

# Key bindings for common actions
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+n=new_window
keybind = ctrl+t=new_tab
keybind = ctrl+shift+w=close_surface
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size

keybind = alt+shift+plus=new_split:right
keybind = alt+shift+minus=new_split:down
keybind = alt+right=goto_split:right
keybind = alt+l=goto_split:right
keybind = alt+left=goto_split:left
keybind = alt+h=goto_split:left
keybind = alt+up=goto_split:up
keybind = alt+k=goto_split:up
keybind = alt+down=goto_split:down
keybind = alt+j=goto_split:down

# Material 3 UI elements
unfocused-split-opacity = 0.7
unfocused-split-fill = #44464f

# Tab configuration
gtk-titlebar = false

# Shell integration
shell-integration = detect
shell-integration-features = cursor,sudo,title,no-cursor
keybind = shift+enter=text:\n

# Rando stuff
gtk-single-instance = true

theme = Catppuccin Mocha
